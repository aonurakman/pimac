{
  "attn_embed_dim": 64,
  "attn_n_heads": 4,
  "batch_size": 64,
  "buffer_size": 5000,
  "entity_schema": {
    "groups": [
      {
        "active_rule": "always",
        "count": 1,
        "name": "self",
        "slice": [
          0,
          4
        ],
        "type": "self",
        "width": 4
      },
      {
        "active_count_offset": 0,
        "active_rule": "first_n_agents_clamped",
        "count": 3,
        "name": "landmarks",
        "slice": [
          4,
          10
        ],
        "type": "landmark",
        "width": 2
      },
      {
        "active_count_offset": -1,
        "active_rule": "first_n_agents_clamped",
        "count": 3,
        "name": "teammates",
        "slice": [
          10,
          16
        ],
        "type": "teammate",
        "width": 2
      }
    ]
  },
  "epsilon_anneal_steps": 300000,
  "epsilon_finish": 0.2,
  "epsilon_start": 1.0,
  "gamma": 0.99,
  "hypernet_embed": 64,
  "lmbda": 0.75,
  "lr": 0.0002754959475760583,
  "max_grad_norm": 10.0,
  "mi_alpha_anneal_steps": 200000,
  "mi_alpha_end": 0.01,
  "mi_alpha_start": 0.01,
  "mixer_chunk_size": 128,
  "mixing_embed_dim": 32,
  "optim_alpha": 0.99,
  "optim_eps": 1e-05,
  "rnn_hidden_dim": 64,
  "share_parameters": true,
  "target_update_every": 400,
  "test_greedy": true,
  "weight_decay": 0.0
}
